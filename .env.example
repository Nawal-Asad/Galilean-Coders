# Copy this file to .env and edit values for your environment.
# Keep .env private; it is excluded from version control.

# Server listener. For a hosting platform, use HOST=0.0.0.0 and set PORT
# to the port supplied by the platform.
HOST=127.0.0.1
PORT=8000

# Paths can be relative to the project root or absolute paths on persistent
# storage. DATA_DIR contains raw/ and processed/ subdirectories.
SPHEREX_DATA_DIR=data
SPHEREX_RESULTS_DIR=results

# Comma-separated browser origins allowed to call the API.
# Replace these with your actual site origins when the frontend and API
# use different domains. Use * only when public cross-origin access is intended.
SPHEREX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5000,http://localhost:5000
